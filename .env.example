# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# OWNER_EMAIL: Primary Owner / Super Admin email address.
OWNER_EMAIL="business.atharvk@gmail.com"
# Optional immutable Owner Firebase UID lock (automatically locked on first verified Owner sign-in; never store passwords here).
OWNER_UID=""

# TRANSACTIONAL EMAIL (Choose SMTP via Nodemailer OR Resend API)
# For Gmail SMTP, use an App Password (never your regular password) with SMTP_HOST="smtp.gmail.com", SMTP_PORT="465", SMTP_SECURE="true".
SMTP_HOST=""
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Atharv Kamath Hub <no-reply@yourdomain.com>"

# Resend API transactional email
RESEND_API_KEY=""
RESEND_FROM_EMAIL="onboarding@resend.dev"
SUPPORT_EMAIL=""

# SECURITY & STORAGE
# Secret key for signing time-limited Gaming Zone download URLs (set a strong random string in production)
DOWNLOAD_TOKEN_SECRET=""
MAX_GAME_FILE_SIZE_MB="500"
STORAGE_QUOTA_MB="5120"

# Optional Firebase Admin Service Account JSON (for direct Firebase Storage bucket uploads, V4 signed URLs, and background request expiration)
FIREBASE_SERVICE_ACCOUNT_JSON=""

# Optional VirusTotal API Key for extra cloud hash/malware scanning
VIRUSTOTAL_API_KEY=""
